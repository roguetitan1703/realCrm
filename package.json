{
  "name": "bhumi-propcity-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx backend/src/scripts/run-api.ts --env=development --watch",
    "dev:api:prod": "tsx backend/src/scripts/run-api.ts --env=production --port=5000 --watch",
    "start:api": "tsx backend/src/scripts/run-api.ts --env=production",
    "start:api:dev": "tsx backend/src/scripts/run-api.ts --env=development",
    "build": "npm run check:vocab && vite build --mode production",
    "build:dev": "npm run check:vocab && vite build --mode development",
    "preview": "vite preview",
    "seed:dev": "tsx backend/src/scripts/seed-dev.ts",
    "deploy:dev": "npx vercel deploy --local-config vercel.development.json --yes",
    "check:vocab": "node scripts/check-vocabulary.mjs",
    "test:ingest": "node scripts/ingest-conformance.mjs",
    "test:leadflows": "tsx scripts/ingest-lead-flows.mjs",
    "seed:dev:login": "tsx backend/src/scripts/seed-dev-login.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "vite": "^6.0.7"
  }
}
