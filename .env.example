# ============================================================================
# Bhumi Propcity CRM — environment template
# Copy to `.env` (backend, local) and set the frontend var in Vercel.
# ============================================================================

# ---------------------------------------------------------------------------
# FRONTEND (Vite) — inlined into the bundle at BUILD time
# ---------------------------------------------------------------------------
# The API origin. Trailing /api/v1 is optional.
# Local dev: leave UNSET — the app falls back to http://localhost:5000.
# Production: set this in the VERCEL DASHBOARD (.env.production is gitignored,
# so Vercel never sees it from the repo). Redeploy after changing it.
VITE_API_URL=https://api.re.delpat.in

# ---------------------------------------------------------------------------
# BACKEND (Express on AWS)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
PORT=5000

# Set to 'true' when starting the API directly (tsx backend/src/index.ts).
START_SERVER=true

# ---------------------------------------------------------------------------
# AUTH (Phase 0)
# ---------------------------------------------------------------------------
# Secret for signing JWTs. MUST be set to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# First superadmin (Delpat staff). Password is hashed on boot, never stored raw.
SUPERADMIN_EMAIL=delpatllp@gmail.com
SUPERADMIN_PASSWORD=set-a-strong-password-at-deploy

# Demo mode: return the OTP in the API response so a live demo needs no SMS.
# MUST stay unset in production. It does more than echo the code: with it on,
# an OTP login from an UNKNOWN number signs you in as the workspace owner, so
# anyone who can reach the login page gets the whole desk. Uncomment locally
# only. (OTP is being retired for password auth.)
# DEMO_OTP=true

# ---------------------------------------------------------------------------
# DEMO DATASET — leave BOTH unset in production
# ---------------------------------------------------------------------------
# Plants the bundled Skyline Realty dataset (agents, listings, leads) on boot,
# into the 'skyline-realty' tenant only. Real workspaces are created through
# onboarding and are never touched by it.
#
# Unset, nothing is seeded. This used to run whenever the database happened to
# hold no leads at all, which is true of any fresh deploy or restored backup —
# so an empty production database would come up carrying a demo firm.
#
# The in-app workspace reset (Settings → System) does not need this: it is an
# explicit action on a workspace someone is looking at.
# SEED_DEMO=true

# Workspace owner on the demo tenant, so login codes reach an inbox you control.
# Only read while seeding; irrelevant when SEED_DEMO is unset.
DEMO_OWNER_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# AUTH V2 (password login + sessions) — docs/specs/auth.md
# ---------------------------------------------------------------------------
# Sliding session length in days (default 30).
SESSION_TTL_DAYS=30
# Base URL used to build password-reset links: <APP_BASE_URL>/<tenant>/reset?token=
APP_BASE_URL=https://realestate.delpat.in
# Password written into any account that had none, during the one-time password
# cutover (backfill_password_auth). It has already run, so this only affects a
# fresh database — but whatever it is set to becomes a REAL working password on
# every account it touches, so set it to something you would not mind being the
# temporary password for a whole workspace, and rotate those accounts after.
DEMO_USER_PASSWORD=change-me-before-first-boot

# ---------------------------------------------------------------------------
# EMAIL (SMTP) — delivers login OTPs (and future transactional mail)
# ---------------------------------------------------------------------------
# Any SMTP host works. For AWS SES: host email-smtp.<region>.amazonaws.com,
# port 587 (secure=false, STARTTLS), user/pass = your SES SMTP credentials.
# If unset, email delivery is disabled and OTP falls back to demo mode.
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# From address (SES SMTP usernames aren't valid senders — set a verified identity).
EMAIL_FROM=no-reply@delpat.in
EMAIL_FROM_NAME=Real Estate by Delpat

# ---------------------------------------------------------------------------
# WEB PUSH (VAPID) — phone notifications with the app closed, no Firebase
# ---------------------------------------------------------------------------
# Generate a keypair once: `npx web-push generate-vapid-keys`.
# Set BOTH on the backend. If unset, push is disabled and the in-app feed
# still works. The public key is exposed to clients; the private key is secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:delpatllp@gmail.com

# ---------------------------------------------------------------------------
# MEDIA STORAGE (Cloudflare R2, S3-compatible) — docs/specs/contacts-leads.md B4
# Shared by visit-proof selfies (B4) and property photos/videos (Block C).
# We only ever store the R2 key/URL in Postgres — never image bytes.
# ---------------------------------------------------------------------------
# Cloudflare dashboard -> R2 -> Manage API tokens -> create a token scoped to
# THIS bucket only (Object Read & Write). Account ID is on the R2 overview page.
# The bucket stays PRIVATE — no public access, no custom domain, nothing to
# upgrade a Cloudflare plan for. Node holds the S3 credentials and is the only
# thing that talks to R2:
#   download -> GET /files/:key streams from R2 through the API, with
#               Cache-Control: immutable, max-age=1y + ETag/304. Keys are
#               random and never overwritten (a replaced photo is a NEW key),
#               so objects are immutable and browsers cache them forever.
#   upload   -> presigned PUT straight from the browser to R2, so multi-MB
#               phone photos never pass through the Express process. This
#               needs a CORS rule on the bucket allowing PUT from our origins.
# Postgres stores the KEY, not a URL; the frontend builds ${API_BASE}/files/<key>
# so local dev and prod work with no extra config.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=re-delpat
# S3-compatible endpoint for that account: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# -- Local disk cache for the /files proxy ----------------------------------
# Keeps a copy on the API box so ten agents opening the same listing cost one
# R2 fetch, not ten. Safe to cache blindly: objects are immutable (a replaced
# photo is a NEW key), so an entry can never go stale and the TTLs below are
# purely a disk-space policy. Delete the directory any time; it refills.
MEDIA_CACHE_DIR=
MEDIA_CACHE_TTL_DAYS=2
# Video is much more expensive to re-pull, so it earns a longer stay.
MEDIA_CACHE_VIDEO_TTL_DAYS=7
# Hard ceiling. Oldest entries are evicted first once the cache exceeds this.
MEDIA_CACHE_MAX_MB=2048
# Optional, currently unused. The upload/serve path needs only the R2
# (S3-compatible) keys above. This is Cloudflare's general account API token —
# it would matter if we ever script account-level setup (attaching a CDN
# hostname to the bucket) rather than clicking through the dashboard.
CLOUDFLARE_API_TOKEN=
