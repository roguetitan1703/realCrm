# ============================================================================
# Local setup: the CRM on your own machine, against your own Postgres.
#
# `npm run setup:local` copies this to `.env` (only when there is no .env yet)
# and fills in the three {{…}} values. Nothing here is a secret of ours: the
# JWT secret and superadmin password are generated on your machine.
# ============================================================================

# Which database this process may touch. development selects DEV_DATABASE_URL
# and never falls back to anything else.
APP_ENV=development

# Your local Postgres. There is deliberately no DATABASE_URL in a local setup.
DEV_DATABASE_URL={{DEV_DATABASE_URL}}

# Signs sign-in tokens. Random per machine.
JWT_SECRET={{JWT_SECRET}}

# Delpat staff console (/admin). Not needed for normal use.
SUPERADMIN_EMAIL=admin@example.invalid
SUPERADMIN_PASSWORD={{SUPERADMIN_PASSWORD}}

# The frontend (npm run dev) calls the API here; npm run dev:api listens on 5001.
VITE_API_URL=http://localhost:5001

# Optional, and off when unset (the API says so once at boot):
#   EMAIL_HOST / EMAIL_USER / EMAIL_PASSWORD   outbound email
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY       push notifications
#   R2_* and MEDIA_*                           photo and file upload
# See .env.example for what each one does.
